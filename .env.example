# Canonical public URL (used for metadata, Open Graph, sitemap). Inlined at build time.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Contact form (Resend). Without RESEND_API_KEY the form falls back to opening the visitor's mail client.
RESEND_API_KEY=
# Optional: defaults to the site email / Resend's shared test sender.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
